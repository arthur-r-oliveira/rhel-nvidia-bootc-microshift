# Copy to .env.azure next to this file, fill in, then: chmod 600 .env.azure
# cloud/azure/.env.azure is gitignored. Never commit or paste real secrets.
#
# Map from typical OpenEnv-style exports:
#   CLIENT_ID     -> AZURE_CLIENT_ID
#   PASSWORD      -> AZURE_CLIENT_SECRET   (rotate if it was ever exposed)
#   TENANT        -> AZURE_TENANT_ID      (domain or directory GUID both work)
#   SUBSCRIPTION  -> AZURE_SUBSCRIPTION
#   RESOURCEGROUP -> AZURE_RESOURCE_GROUP   (default for push-vhd-to-azure.sh)
#
# Optional (push script):
#   AZURE_LOCATION=eastus
#
# GUID=... is only a lab label; optional for your own naming (not required for az login).

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION=
AZURE_RESOURCE_GROUP=
# AZURE_LOCATION=
